{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Flowy",
  "colors": {
    "primary": "#5C9987",
    "light": "#5C9987",
    "dark": "#4A7E6F"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/concepts"
            ]
          },
          {
            "group": "Canvas Editor",
            "pages": [
              "canvas/overview",
              "canvas/navigation",
              "canvas/nodes",
              "canvas/ai-chat"
            ]
          },
          {
            "group": "Generators",
            "pages": [
              "generators/overview",
              "generators/image",
              "generators/video",
              "generators/audio",
              "generators/flam",
              "generators/storyboard"
            ]
          },
          {
            "group": "Studio",
            "pages": [
              "studio/overview",
              "studio/timeline",
              "studio/export"
            ]
          },
          {
            "group": "Collaboration & Workspaces",
            "pages": [
              "collaboration/workspaces",
              "collaboration/roles",
              "collaboration/sharing"
            ]
          }
        ]
      },
      {
        "tab": "Help Center",
        "icon": "life-ring",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "help/overview",
              "help/account",
              "help/contact"
            ]
          },
          {
            "group": "Credits & billing",
            "pages": [
              "billing/credits",
              "help/payments",
              "help/refunds"
            ]
          },
          {
            "group": "Using Flowy",
            "pages": [
              "help/generating",
              "help/exporting",
              "help/collaboration"
            ]
          },
          {
            "group": "Troubleshooting & FAQ",
            "pages": [
              "help/troubleshooting",
              "help/faq"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/flowy-black.png",
    "dark": "/logo/flowy-white.png",
    "href": "https://tryflowy.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@tryflowy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://tryflowy.ai/signin"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/flowy_ai",
      "instagram": "https://instagram.com/flowy.ai",
      "facebook": "https://facebook.com/flowy.ai"
    }
  }
}
