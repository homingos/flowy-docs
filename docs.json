{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Flowy",
  "colors": {
    "primary": "#5C9987",
    "light": "#5C9987",
    "dark": "#4A7E6F"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Golos Text",
      "weight": 600
    },
    "body": {
      "family": "Golos Text",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "expanded": true,
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/concepts"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/projects",
              "dashboard/assets",
              "dashboard/brand-kit",
              "dashboard/community",
              "dashboard/updates"
            ]
          },
          {
            "group": "Canvas",
            "pages": [
              "canvas/overview",
              "canvas/navigation",
              "canvas/toolbar",
              {
                "group": "Nodes",
                "pages": [
                  "canvas/nodes/overview",
                  "canvas/nodes/text",
                  "canvas/nodes/image",
                  "canvas/nodes/video",
                  "canvas/nodes/audio",
                  "canvas/nodes/3d",
                  "canvas/nodes/vector",
                  "canvas/nodes/flam",
                  "canvas/nodes/storyboard",
                  "canvas/nodes/composition",
                  "canvas/nodes/motion-path",
                  "canvas/nodes/utility-nodes"
                ]
              },
              {
                "group": "Image Tools",
                "pages": [
                  "canvas/image-tools/overview",
                  "canvas/image-tools/transform-and-adjust",
                  "canvas/image-tools/upscale",
                  "canvas/image-tools/inpaint",
                  "canvas/image-tools/outpaint",
                  "canvas/image-tools/remove-background",
                  "canvas/image-tools/change-angle",
                  "canvas/image-tools/separate-layers"
                ]
              },
              "canvas/quick-actions",
              {
                "group": "AI Assistant",
                "pages": [
                  "canvas/ai/overview",
                  "canvas/ai/agent-actions",
                  "canvas/ai/plan-mode",
                  "canvas/ai/memory-and-skills",
                  "canvas/ai/voice-and-cursor-chat",
                  "canvas/ai/canvas-audit"
                ]
              },
              "canvas/keyboard-shortcuts"
            ]
          },
          {
            "group": "Studio",
            "pages": [
              "studio/overview",
              "studio/timeline",
              "studio/inspector",
              {
                "group": "Effects & Transitions",
                "pages": [
                  "studio/effects/overview",
                  "studio/effects/color-correction",
                  "studio/effects/stylize",
                  "studio/effects/chroma-key",
                  "studio/effects/transitions"
                ]
              },
              "studio/ai-chat",
              "studio/export"
            ]
          },
          {
            "group": "Collaboration",
            "pages": [
              "collaboration/workspaces",
              "collaboration/roles",
              "collaboration/real-time",
              "collaboration/sharing",
              "collaboration/voice-rooms"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "settings/account",
              "settings/workspace",
              "settings/usage",
              "settings/api-keys",
              "settings/logs"
            ]
          }
        ]
      },
      {
        "tab": "Help Center",
        "icon": "life-ring",
        "groups": [
          {
            "group": "Start Here",
            "expanded": true,
            "pages": [
              "help/overview",
              "help/account",
              "help/contact"
            ]
          },
          {
            "group": "Plans, Credits & Billing",
            "pages": [
              "billing/plans",
              "billing/credits",
              "help/payments",
              "help/refunds"
            ]
          },
          {
            "group": "Using Flowy",
            "pages": [
              "help/generating",
              "help/exporting",
              "help/collaboration"
            ]
          },
          {
            "group": "Troubleshooting & FAQ",
            "pages": [
              "help/troubleshooting",
              "help/faq"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "expanded": true,
            "pages": [
              "api/introduction",
              "api/authentication",
              "api/permissions",
              "api/running-apps"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api/list-apps",
              "api/get-app",
              "api/start-run",
              "api/get-run",
              "api/get-openapi"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api/rate-limits",
              "api/errors"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/getting-started/quickstart" },
    { "source": "/canvas/nodes", "destination": "/canvas/nodes/overview" },
    { "source": "/canvas/ai-chat", "destination": "/canvas/ai/overview" },
    { "source": "/generators/overview", "destination": "/canvas/nodes/overview" },
    { "source": "/generators/image", "destination": "/canvas/nodes/image" },
    { "source": "/generators/video", "destination": "/canvas/nodes/video" },
    { "source": "/generators/audio", "destination": "/canvas/nodes/audio" },
    { "source": "/generators/flam", "destination": "/canvas/nodes/flam" },
    { "source": "/generators/storyboard", "destination": "/canvas/nodes/storyboard" }
  ],
  "logo": {
    "light": "/logo/flowy-black.png",
    "dark": "/logo/flowy-white.png",
    "href": "https://tryflowy.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@tryflowy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://tryflowy.ai/signin"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/TryFlowyAI",
      "instagram": "https://www.instagram.com/tryflowyai/",
      "linkedin": "https://www.linkedin.com/in/flowy-ai-756474412/",
      "youtube": "https://www.youtube.com/@tryflowyai",
      "reddit": "https://www.reddit.com/r/FlowyAI/",
      "discord": "https://discord.gg/nTeVdHpZ"
    }
  }
}
