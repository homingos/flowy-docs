            "pages": [
              "billing/credits",
              "help/payments",
              "help/refunds"
            ]
          },
          {
            "group": "Using Flowy",
            "pages": [
              "help/generating",
              "help/exporting",
              "help/collaboration"
            ]
          },
          {
            "group": "Troubleshooting & FAQ",
            "pages": [
              "help/troubleshooting",
              "help/faq"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
