{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flowy",
  "colors": {
    "primary": "#5C9987",
    "light": "#5C9987",
    "dark": "#4A7E6F"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/concepts"
        ]
      },
      {
        "group": "Canvas Editor",
        "pages": [
          "canvas/overview",
          "canvas/navigation",
          "canvas/nodes",
          "canvas/ai-chat"
        ]
      },
      {
        "group": "Generators",
        "pages": [
          "generators/overview",
          "generators/image",
          "generators/video",
          "generators/audio",
          "generators/flam",
          "generators/storyboard"
        ]
      },
      {
        "group": "Studio",
        "pages": [
          "studio/overview",
          "studio/timeline",
          "studio/export"
        ]
      },
      {
        "group": "Collaboration & Workspaces",
        "pages": [
          "collaboration/workspaces",
          "collaboration/roles",
          "collaboration/sharing"
        ]
      },
      {
        "group": "Credits & Billing",
        "pages": [
          "billing/credits"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/faq",
          "help/troubleshooting"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://tryflowy.ai",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/flowy-black.png",
    "dark": "/logo/flowy-white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@tryflowy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Flowy",
      "href": "https://tryflowy.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/flowy_ai",
      "instagram": "https://instagram.com/flowy.ai",
      "facebook": "https://facebook.com/flowy.ai"
    }
  }
}
